{
    "manifest_version": 3,
    "name": "Hype Haber Merkezi",
    "version": "1.0",
    "description": "Hype'ın Kick yayınlarını, YouTube videolarını ve Instagram gönderilerini takip edin.",
    "permissions": [
        "storage",
        "notifications",
        "alarms"
    ],
    "host_permissions": [
        "https://kick.com/*",
        "https://www.youtube.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Hype Haber Merkezi"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}